@using Extension.Helper
@using Extension.Models
@using Extension.Services
@using Extension.UI.Components
@implements IDisposable

@inject AppCache appCache
@inject IScrollManager scrollManager

@*
    Renders an ACDC SAID value as a monospace span, abbreviated according to the user's
    Preferences.AbbreviateSaids setting (or per-render override via the Abbreviate parameter).
    The full SAID is exposed via a native browser title tooltip so users can inspect it on hover
    regardless of abbreviation. Empty or null Said renders nothing.

    Subscribes to AppCache so the component re-renders when AbbreviateSaids changes live.
    Unsubscribes in Dispose.
*@

@code {
    [Parameter, EditorRequired]
    public string? Said { get; set; }

    /// <summary>Characters shown from the start of the SAID when abbreviated. Default 8.</summary>
    [Parameter]
    public int HeadChars { get; set; } = 4;

    /// <summary>Characters shown from the end of the SAID when abbreviated. Default 4.</summary>
    [Parameter]
    public int TailChars { get; set; } = 4;

    /// <summary>
    /// Per-render override for the Preferences.AbbreviateSaids flag. When null (default),
    /// reads the user preference. Pass true or false to force-abbreviate / force-full on a
    /// specific call site (e.g., compact tables that would wrap without abbreviation).
    /// </summary>
    [Parameter]
    public bool? Abbreviate { get; set; }

    /// <summary>
    /// Provided by CredentialViewTreeRenderer when this SaidDisplay is rendered inside a
    /// credential view. Maps each chained credential's SAID to its tree. When the SAID we
    /// render is a key in this map, a "scroll to chained credential" affordance is shown
    /// next to the SAID and clicking it scrolls to the chain's header (which carries
    /// id=&lt;said&gt; via LabelWithProvenance.Id). Null outside credential views.
    /// </summary>
    [CascadingParameter(Name = "ChainIndex")]
    public Dictionary<string, CredentialViewTree>? ChainIndex { get; set; }

    /// <summary>
    /// Optional render-context path of the field whose value is this SAID, e.g. "e.auth.n"
    /// or "e.auth/.e.le.n" when nested inside an inlined chain. The scroll-to-chain icon
    /// is only rendered when this path indicates an edge field (the last "/" segment, with
    /// any leading "." stripped, starts with "e."). This excludes top-level identifying
    /// SAIDs such as a credential's own "d" — clicking those would link a row to itself.
    /// Null at non-edge call sites.
    /// </summary>
    [Parameter]
    public string? Path { get; set; }

    bool HasChainTarget =>
        !string.IsNullOrEmpty(Said)
        && ChainIndex is { } idx
        && idx.ContainsKey(Said)
        && CredentialPaths.IsEdgePath(Path);

    async Task ScrollToChain() {
        if (string.IsNullOrEmpty(Said)) return;
        // TODO P3: push "#<said>" via NavigationManager so the browser Back button can
        // restore the prior scroll position, and add an OnAfterRenderAsync handler on
        // CredentialPage that reads Uri.Fragment / a query-string parameter and scrolls
        // on initial render. Skipped now to avoid expanding the page's parameter surface.
        await scrollManager.ScrollIntoViewAsync($"#{Said}", ScrollBehavior.Smooth);
    }

    string? DisplayText {
        get {
            if (string.IsNullOrEmpty(Said)) return null;
            var abbreviate = Abbreviate ?? appCache.MyPreferences.AbbreviateSaids;
            if (!abbreviate) return Said;
            if (Said.Length <= HeadChars + TailChars + 1) return Said;
            return TailChars > 0
                ? $"{Said[..HeadChars]}…{Said[^TailChars..]}"
                : $"{Said[..HeadChars]}…";
        }
    }

    protected override async Task OnInitializedAsync() {
        // Ensures this component re-renders when the AbbreviateSaids preference toggles even
        // though the component's parameters didn't change. Parent re-renders alone don't
        // always propagate down through MudBlazor / cascading-value layers reliably.
        await this.SubscribeToAppCache(appCache);
    }

    public void Dispose() {
        this.UnsubscribeFromAppCache();
    }
}

@if (!string.IsNullOrEmpty(Said))
{
    <span class="bt-said" title="@Said">@DisplayText</span>
    @if (HasChainTarget)
    {
        <MudTooltip Text="Scroll to chained credential" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowDown"
                           Size="Size.Small"
                           Color="Color.Primary"
                           aria-label="Scroll to chained credential"
                           OnClick="ScrollToChain" />
        </MudTooltip>
    }
}
