@page "/RequestGrantTva.html"
@layout Layouts.DialogLayout
@inherits Extension.UI.Components.TabDialogPageBase

@using System.Text.Json
@using Extension.Helper
@using Extension.Models
@using Extension.Models.Messages.AppBw
@using Extension.Models.Messages.BwApp
@using Extension.Models.Messages.BwApp.Requests
@using Extension.Models.Storage
@using Extension.Services
@using FluentResults
@using MudBlazor

@inject ILogger<RequestGrantTvaPage> logger
@inject ISnackbar snackbar
@inject AppCache appCache

@code {
    private MudButton? approveButton;

    private RequestGrantTvaPayload? request;

    string? SelectedPrefix { get; set; }
    string? SelectedAlias { get; set; }

    bool IsApproveDisabled => SelectedPrefix is null;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        logger.LogInformation("OnInitializedAsync");

        request = await InitializeFromPendingRequestAsync<RequestGrantTvaPayload>(
            BwAppMessageType.Values.RequestGrantTva);
        if (request is null) return;

        logger.LogInformation("Loaded TVA grant request: requestor={Requestor}, verifierAid={VerifierAid}, requestId={RequestId}",
            request.RequestorName, request.VerifierAid, request.RequestId);

        await LoadActiveTabAsync();
        IsInitialized = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && approveButton is not null)
        {
            await approveButton.FocusAsync();
        }
    }

    async Task<Result> Approve()
    {
        await BeginActionAsync();

        if (request is null)
        {
            return Result.Fail("Request not initialized");
        }

        if (SelectedPrefix is null)
        {
            snackbar.Add("Please select an identifier", Severity.Warning);
            Layout?.EndAction();
            return Result.Fail("No identifier selected");
        }

        try
        {
            logger.LogInformation("Approve: sender={Sender}, verifier={Verifier}, requestId={ReqId}",
                SelectedPrefix, request.VerifierAid, request.RequestId);

            // Step 1: Issue the TVA credential (signing only — no IPEX yet).
            // email ← emailAddress; name ← preferred_username (when sent); role is unset (Q3=D).
            var issueResp = await AppBwPortService.SendRpcRequestAsync(
                AppBwMessageType.Values.RequestIssueTvaCredential,
                new
                {
                    payload = new IssueTvaCredentialRequestPayload(
                        SenderNameOrPrefix: SelectedPrefix,
                        RecipientPrefix: request.VerifierAid,
                        Email: request.EmailAddress,
                        Name: string.IsNullOrWhiteSpace(request.PreferredUsername) ? null : request.PreferredUsername,
                        Role: null)
                },
                timeout: TimeSpan.FromMinutes(3));

            if (!issueResp.Ok || issueResp.Result is not JsonElement issueElement)
            {
                var err = issueResp.Error ?? "Failed to issue TVA credential";
                snackbar.Add($"Issue failed: {err}", Severity.Error);
                Layout?.EndAction();
                return Result.Fail(err);
            }

            var issueResult = JsonSerializer.Deserialize<IssueTvaCredentialResponsePayload>(
                issueElement.GetRawText(), Helper.JsonOptions.CamelCase);
            if (issueResult is null || !issueResult.Success
                || issueResult.Acdc is null || issueResult.Anc is null || issueResult.Iss is null
                || string.IsNullOrEmpty(issueResult.CredentialSaid))
            {
                var err = issueResult?.Error ?? "Issue returned an incomplete result";
                snackbar.Add($"Issue failed: {err}", Severity.Error);
                Layout?.EndAction();
                return Result.Fail(err);
            }

            logger.LogInformation("Approve: credential issued, said={Said}", issueResult.CredentialSaid);

            // Step 2: Submit an unsolicited IPEX grant to the verifier. The ExnPayload carries
            // the OIDC correlation tuple. signify-ts hardcodes exn.a = { m: message } so the TS
            // bundle JSON-stringifies our payload into `message`; verifier admit-side recovers
            // via JSON.parse(exn.a.m).dign.requestId. See spec Q5.
            var exnPayload = new RecursiveDictionary
            {
                ["dign"] = new RecursiveValue
                {
                    Dictionary = new RecursiveDictionary
                    {
                        ["requestId"] = new RecursiveValue { StringValue = request.RequestId }
                    }
                }
            };

            var grantResp = await AppBwPortService.SendRpcRequestAsync(
                AppBwMessageType.Values.RequestSubmitIpexGrant,
                new
                {
                    payload = new SubmitIpexGrantRequestPayload(
                        SenderNameOrPrefix: SelectedPrefix,
                        RecipientPrefix: request.VerifierAid,
                        Acdc: issueResult.Acdc,
                        Anc: issueResult.Anc,
                        Iss: issueResult.Iss,
                        AgreeSaid: null,
                        ExnPayload: exnPayload)
                },
                timeout: TimeSpan.FromMinutes(3));

            if (!grantResp.Ok || grantResp.Result is not JsonElement grantElement)
            {
                var err = grantResp.Error ?? "Failed to submit IPEX grant";
                snackbar.Add($"Grant failed: {err}", Severity.Error);
                Layout?.EndAction();
                return Result.Fail(err);
            }

            var grantResult = JsonSerializer.Deserialize<SubmitIpexGrantResponsePayload>(
                grantElement.GetRawText(), Helper.JsonOptions.CamelCase);
            if (grantResult is null || !grantResult.Success || string.IsNullOrEmpty(grantResult.GrantSaid))
            {
                var err = grantResult?.Error ?? "Grant returned failure";
                snackbar.Add($"Grant failed: {err}", Severity.Error);
                Layout?.EndAction();
                return Result.Fail(err);
            }

            logger.LogInformation("Approve: grant submitted, grantSaid={GrantSaid}", grantResult.GrantSaid);

            // Step 3: Tell the BW to forward the result to the originally-requesting ContentScript.
            // The verifier's web page is awaiting the polaris-web reply with { credentialSaid, grantSaid }.
            var originalRequestId = request.OriginalRequestId ?? request.RequestId;
            var replyResp = await AppBwPortService.SendRpcRequestAsync(
                AppBwMessageType.Values.ReplyGrantTva,
                new
                {
                    payload = new ReplyGrantTvaPayload(
                        OriginalRequestId: originalRequestId,
                        CredentialSaid: issueResult.CredentialSaid,
                        GrantSaid: grantResult.GrantSaid)
                },
                timeout: TimeSpan.FromSeconds(10));

            if (!replyResp.Ok)
            {
                // Non-fatal: the grant has been submitted to KERIA. Log + warn but proceed.
                logger.LogWarning("Approve: ReplyGrantTva to BW failed: {Error}. Grant is still complete in KERIA.",
                    replyResp.Error);
                snackbar.Add("Grant complete, but result was not forwarded to the requesting page.", Severity.Warning);
            }
            else
            {
                snackbar.Add("TVA attestation granted to verifier", Severity.Success);
            }

            MarkAsReplied();
            await ClearPendingRequestAsync();
            await WaitForAppCacheClearAsync();
            await ReturnToPriorUIAsync();
            return Result.Ok();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Failed to grant TVA attestation");
            snackbar.Add($"Failed: {ex.Message}", Severity.Error);
            Layout?.EndAction();
            return Result.Fail(new JavaScriptInteropError("GrantTva", ex.Message, ex));
        }
    }

    async Task Cancel()
    {
        await CancelAndReturnAsync("User canceled TVA attestation request");
    }

    private async Task HandleIdOrCredChanged((string selectedPrefix, string selectedAlias, RecursiveDictionary? selectedCredentialOrNothing, WebsiteConfig? websiteConfig) value)
    {
        SelectedPrefix = value.selectedPrefix;
        SelectedAlias = value.selectedAlias;
        StateHasChanged();
        if (approveButton is not null)
        {
            await approveButton.FocusAsync();
        }
    }

    private async Task ApproveHandler()
    {
        var result = await Approve();
        if (result.IsFailed)
        {
            logger.LogError("TVA attestation approval failed: {Error}", result.Errors.FirstOrDefault()?.Message);
        }
    }
}

@if (IsInitialized && request is not null)
{
    <div id="@this.GetType().Name" class="bt-body-page">
        <MudStack Class="bt-main">
            <div class="bt-main-inside-scroll">
                <PageHeading Title="Request to create attestation" />

                @if (ActiveTab is not null)
                {
                    <TabInteractionDisplay ActiveTab=@ActiveTab />
                }

                <MudText Class="ml-9" Typo="Typo.body2">
                    <em>@request.RequestorName</em>
                    is requesting you to attest to your control of
                    the selected identifier, your email address,
                    and the other data shown below
                    via a <em>TradeVeris Access Credential</em>
                    that will be granted to the verifier for website authentication.
                </MudText>

                <WebsiteConfigDisplay OriginStr="@OriginStr"
                                      IsOriginShown="false"
                                      IsCredentialShown="false"
                                      IsAutoSignShown="false"
                                      ValueChanged="async (v) => await HandleIdOrCredChanged(v)" />

                <MudText Class="bt-section-title">Attested claims:</MudText>
                <MudPaper Elevation="1" Class="pa-3 mb-2" Style="background-color: var(--mud-palette-background-grey);">
                    <MudText Typo="Typo.body2"><strong>Email:</strong> @request.EmailAddress</MudText>
                    @if (!string.IsNullOrWhiteSpace(request.PreferredUsername))
                    {
                        <MudText Typo="Typo.body2"><strong>Preferred username:</strong> @request.PreferredUsername</MudText>
                    }
                </MudPaper>

                <MudText Class="bt-section-title">Verifier:</MudText>
                <MudPaper Elevation="1" Class="pa-3 mb-2" Style="background-color: var(--mud-palette-background-grey);">
                    <MudText Typo="Typo.body2"><strong>AID:</strong> <span class="bt-prefix">@request.VerifierAid</span></MudText>
                    <MudText Typo="Typo.body2" Style="word-break: break-all;"><strong>OOBI:</strong> @request.VerifierOobi</MudText>
                </MudPaper>

                <MudText Class="bt-section-title">Verifier request:</MudText>
                <MudPaper Elevation="1" Class="pa-3 mb-2" Style="background-color: var(--mud-palette-background-grey);">
                    <MudText Typo="Typo.body2"><strong>Request id:</strong> <span class="bt-prefix">@request.RequestId</span></MudText>
                    <MudText Typo="Typo.body2"><strong>Timestamp:</strong> @request.DateTime</MudText>
                </MudPaper>
            </div>
        </MudStack>

        <MudStack Row="true" class="bt-button-tray">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(async (_) => await Cancel())">Reject</MudButton>
            <MudButton @ref="approveButton"
                       Disabled="IsApproveDisabled"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="ApproveHandler">
                Approve &amp; Grant
            </MudButton>
        </MudStack>
    </div>
}
